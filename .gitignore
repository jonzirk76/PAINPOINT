# Godot 4+ specific ignores
.godot/
/android/

# Local export artifacts/templates
/builds/
/build_templates/
/export_presets.cfg
art/generated/characters/velora/base/*

# Local LLM/model artifacts
*.gguf
*.ggml
*.safetensors
/models/
/local_models/
/llm_models/

# Optional local LLM addon packages
/addons/nobodywho/

# Local runtime/config overrides
.env
.env.*
!.env.example
/resources/local/
*.local.tres
*.local.cfg
*.local.json

# Generated dialogue/art scratch output
/art/generated/dialogue/
/art/generated/scratch/

# Large local anatomy reference meshes
/art/3d models/human-skeleton-*/

# Logs and local diagnostics
*.log
/logs/
/.local-model-runs/
/.smoke-test-runtime/

# Extra export/build artifacts
/exports/
/dist/
/releases/
*.pck
*.apk
*.aab
